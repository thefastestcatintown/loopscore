---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  align?: "left" | "center";
}

const { eyebrow, title, text, align = "left" } = Astro.props as Props;
---

<div class:list={["section-intro", align === "center" && "section-intro--center"]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
  {text && <p>{text}</p>}
</div>
