---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import {
  defaultDescription,
  defaultOgImage,
  defaultTitle,
  siteName,
  siteUrl,
} from "../lib/site";
import { withBase } from "../lib/paths";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  showPackageNav?: boolean;
}

const {
  title = defaultTitle,
  description = defaultDescription,
  image = defaultOgImage,
  noindex = false,
  showPackageNav = true,
} = Astro.props as Props;

const cloudflareAnalyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN;
const canonicalPath = Astro.url.pathname.startsWith(Astro.site?.pathname ?? "")
  ? Astro.url.pathname
  : withBase(Astro.url.pathname);
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const ogImageUrl = new URL(withBase(image), siteUrl).toString();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: siteName,
  applicationCategory: "BusinessApplication",
  operatingSystem: "iOS, Android, Web",
  url: new URL(withBase("/"), siteUrl).toString(),
  description,
  offers: {
    "@type": "Offer",
    availability: "https://schema.org/InStock",
  },
};

const cssImageVars = {
  heroFlat: `url("${withBase("/assets/adventure-golf/animation/hero-flat-flag.jpg")}")`,
  checkIcon: `url("${withBase("/assets/adventure-golf/icons/svg/bestaetigt-erledigt.svg")}")`,
  journeyFamily: `url("${withBase("/assets/adventure-golf/background/background-journey-family.jpg")}")`,
  backgroundMist: `url("${withBase("/assets/adventure-golf/background/background3-mist.png")}")`,
  footerFlat: `url("${withBase("/assets/adventure-golf/animation/footer_flat.jpg")}")`,
  backgroundLandscape: `url("${withBase("/assets/adventure-golf/background/background3-landscape.png")}")`,
  backgroundOne: `url("${withBase("/assets/adventure-golf/background/background1.png")}")`,
  ctaMockup: `url("${withBase("/assets/adventure-golf/mockUps/de8385f1-b359-4992-9e05-42ee38710714-cutout.png")}")`,
};

const cssImageVarStyles = `
  :root {
    --image-hero-flat: ${cssImageVars.heroFlat};
    --image-check-icon: ${cssImageVars.checkIcon};
    --image-journey-family: ${cssImageVars.journeyFamily};
    --image-background-mist: ${cssImageVars.backgroundMist};
    --image-footer-flat: ${cssImageVars.footerFlat};
    --image-background-landscape: ${cssImageVars.backgroundLandscape};
    --image-background-one: ${cssImageVars.backgroundOne};
    --image-cta-mockup: ${cssImageVars.ctaMockup};
  }
`;
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#234d39" />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/png" href={withBase("/assets/adventure-golf/logo/app-icon-512.png")} />
    <link rel="apple-touch-icon" href={withBase("/assets/adventure-golf/logo/app-icon-512.png")} />
    <link rel="manifest" href={withBase("/site.webmanifest")} />
    <style is:inline set:html={cssImageVarStyles} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {
      cloudflareAnalyticsToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cloudflareAnalyticsToken })}
        />
      )
    }
    <title>{title}</title>
  </head>
  <body>
    <SiteHeader showPackageNav={showPackageNav} />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
